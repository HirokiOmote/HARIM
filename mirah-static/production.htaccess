DirectoryIndex index.html
Options -Indexes

# Advertise the same usage policy for documents and images, including direct image requests.
<FilesMatch "(?i)\.html$">
  Header always merge Link '<https://mirah.jp/rsl.xml>; rel="license"; type="application/rsl+xml"'
</FilesMatch>
Header always merge Link '<https://mirah.jp/rsl.xml>; rel="license"; type="application/rsl+xml"' "expr=%{REQUEST_URI} =~ m#\.(?:avif|gif|ico|jpe?g|png|svg|webp)$#i"
<Files "ai-usage.txt">
  ForceType text/plain
  AddDefaultCharset UTF-8
  Header always merge Link '<https://mirah.jp/rsl.xml>; rel="license"; type="application/rsl+xml"'
</Files>
<Files "rsl.xml">
  ForceType application/rsl+xml
</Files>

RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^mirah\.jp$ [NC]
RewriteRule ^ https://mirah.jp%{REQUEST_URI} [R=301,L]

# Redirect explicit index.html requests, without redirecting DirectoryIndex internally.
RewriteCond %{THE_REQUEST} \s/+[^\s?]*index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://mirah.jp/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*index\.html(?:[?\s]) [NC]
RewriteRule ^(shoplist)/index\.html$ https://mirah.jp/$1/ [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)page_id=25(&|$)
RewriteRule ^(?:index\.php)?$ /shoplist/ [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=4(&|$)
RewriteRule ^(?:index\.php)?$ https://mirah-store.com/inquiry [R=301,L,QSD]
RewriteRule ^contact(?:/index\.html)?/?$ https://mirah-store.com/inquiry [R=301,L,QSD]
RewriteRule ^index\.php$ / [R=301,L,QSD]

# The build appends redirects for the original public image URLs.
